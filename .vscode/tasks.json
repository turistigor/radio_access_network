{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PlantUML Local Server",
            "type": "shell",
            "command": "java",
            "args": [
                "-Dplantuml.include.path=${workspaceFolder}",
                "-jar",
                "${userHome}/.vscode/extensions/jebbs.plantuml-2.18.1/plantuml.jar",
                "-picoweb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen" // Сервер будет запускаться САМ автоматически при открытии проекта
            },
            "isBackground": true, // Указывает VS Code, что это фоновый процесс (сервер)
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^.*PlantUML server started.*$" 
                }
            }
        }
    ]
}
